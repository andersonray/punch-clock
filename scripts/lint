#!/usr/bin/env bash
# Lint and type-check the Python code.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="${PUNCH_CLOCK_VENV:-$HOME/.venvs/punch-clock}"
cd "$REPO"

"$VENV/bin/ruff" format --check .
"$VENV/bin/ruff" check .
"$VENV/bin/mypy" custom_components/punch_clock/logic
